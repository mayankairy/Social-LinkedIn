generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  photo     String   @default("https://thumbs.dreamstime.com/b/my-cat-her-silly-face-i-know-cringe-cute-m-sorry-311851899.jpg")
}
